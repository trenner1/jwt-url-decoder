{
  "manifest_version": 3,
  "name": "JWT URL Decoder",
  "version": "0.1.0",
  "description": "Detects JWTs in the current tab's URL and decodes them locally.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "dist/background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["webNavigation", "sidePanel", "tabs"]
}
